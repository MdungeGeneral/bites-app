# ── Cloudflare R2 ────────────────────────────────────────────────────────────
# Found in: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id

# Create an API token with "Object Read & Write" on your bucket
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# The name of your R2 bucket
R2_BUCKET_NAME=bites-videos

# Public URL for the bucket (enable "Public Access" on the bucket in R2 dashboard)
# Will look like: https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
